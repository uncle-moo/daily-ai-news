# 时区；日报按该时区计算"昨天"的 00:00-23:59。当前代码第一版只支持 Asia/Shanghai。
TZ=Asia/Shanghai

# OpenAI-compatible LLM API 地址。DeepSeek 可使用 https://api.deepseek.com/v1。
BASE_URL=https://api.deepseek.com/v1

# LLM API Key。本地写在 .env；GitHub Actions 中配置为 Secrets: API_KEY。
API_KEY=

# LLM 模型名。DeepSeek 常用 deepseek-chat 或 deepseek-reasoner。
AI_MODEL=deepseek-chat

# GitHub API token。Actions 中可直接使用内置 GITHUB_TOKEN；本地可留空或填 personal access token 以提高限额。
GITHUB_TOKEN=

# 飞书机器人 webhook。本地写在 .env；GitHub Actions 中配置为 Secrets: FEISHU_WEBHOOK_URL。
FEISHU_WEBHOOK_URL=

# 飞书机器人签名密钥。如果机器人没有开启"签名校验"，可留空。
FEISHU_SECRET=

# 是否让 GitHub Actions 自动提交 reports/YYYY-MM-DD.md 到仓库。GitHub Variables 中配置。
AUTO_COMMIT_REPORT=true

# 是否上传日报为 GitHub Actions artifact。GitHub Variables 中配置。
REPORT_ARTIFACT=true

# 每个数据源最多采集的条目数。数值越大，LLM token 消耗越高。
MAX_ITEMS_PER_SOURCE=30

# 资讯源配置见 sources.json（参考 sources.example.json）。
